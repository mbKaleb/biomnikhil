# ---- provider selection (the whole point of the adapter layer) ----
# one of: anthropic | openai | gemini | azure | ollama | custom
BIOMNI_PROVIDER=anthropic
# optional model override; leave empty for the provider's default
BIOMNI_MODEL=

# ---- keys (only the one for your chosen provider is needed) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# azure reuses OPENAI_API_KEY plus:
OPENAI_ENDPOINT=
# ollama (on-device, no key needed):
OLLAMA_BASE_URL=http://localhost:11434/v1
# custom endpoint:
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# ---- paths / server ----
# default is ../data (inside the disposable box, next to the repo)
BIOMNI_DATA_PATH=
PORT=8000
