# ---- provider selection (the whole point of the adapter layer) ----
# one of: anthropic | openai | gemini | azure | ollama | custom
BIOMNI_PROVIDER=anthropic
# optional model override; leave empty for the provider's default
# openai, one of: gpt-5 | gpt-5-mini | gpt-4.1 | gpt-4o | o3
# anthropic, one of: claude-sonnet-4-5 | claude-opus-4-1 | claude-haiku-4-5
# gemini, one of: gemini-2.5-pro | gemini-2.5-flash
BIOMNI_MODEL=

# ---- keys (only the one for your chosen provider is needed) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# azure reuses OPENAI_API_KEY plus:
OPENAI_ENDPOINT=
# ollama (on-device, no key needed):
OLLAMA_BASE_URL=http://localhost:11434/v1
# custom endpoint:
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# ---- paths / server ----
# defaults live inside the repo: data/ (biomni's data lake) and
# data/user/ (uploads, chat history) — the whole tree is gitignored.
BIOMNI_DATA_PATH=
BIOMNI_UPLOAD_PATH=
BIOMNI_CHAT_DB=
# max size per uploaded file, in MB. Default (2048) covers raw instrument
# files like .mzML mass spec runs, which are often several hundred MB+.
MAX_UPLOAD_MB=2048
PORT=8000
