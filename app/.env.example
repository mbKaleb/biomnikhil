# ---- provider selection (the whole point of the adapter layer) ----
# one of: anthropic | bedrock | openai | gemini | azure | ollama | custom
# bedrock = Claude on Bedrock Mantle, signed per user with Cognito sign-in
# (see the Cognito block below; needs no key)
BIOMNI_PROVIDER=bedrock
# optional model override; leave empty for the provider's default
# bedrock: anthropic.claude-haiku-4-5 (the default)
# openai, one of: gpt-5 | gpt-5-mini | gpt-4.1 | gpt-4o | o3
# anthropic, one of: claude-sonnet-4-5 | claude-opus-4-1 | claude-haiku-4-5
# gemini, one of: gemini-2.5-pro | gemini-2.5-flash
BIOMNI_MODEL=

# ---- keys (only the one for your chosen provider is needed; bedrock needs none) ----
ANTHROPIC_API_KEY=
# optional: e.g. a Bedrock Mantle endpoint; leave empty for api.anthropic.com
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
GEMINI_API_KEY=
# azure reuses OPENAI_API_KEY plus:
OPENAI_ENDPOINT=
# ollama (on-device, no key needed):
OLLAMA_BASE_URL=http://localhost:11434/v1
# custom endpoint:
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# ---- Cognito (bedrock provider only; public ids, not secrets) ----
AWS_REGION=us-west-2
COGNITO_DOMAIN=https://us-west-23tnzmsntd.auth.us-west-2.amazoncognito.com
COGNITO_CLIENT_ID=4o022h426iocu07tkg7njik9bs
COGNITO_USER_POOL_ID=us-west-2_3tnZMsnTd
COGNITO_IDENTITY_POOL_ID=us-west-2:405c18ad-7b3c-433f-a27d-dfedd2eda27a
# must be an allowed callback URL on the app client; defaults to
# http://localhost:$PORT/callback
COGNITO_REDIRECT_URI=

# ---- paths / server ----
# defaults live inside the repo: data/ (biomni's data lake) and
# data/user/ (uploads, chat history) — the whole tree is gitignored.
BIOMNI_DATA_PATH=
BIOMNI_UPLOAD_PATH=
BIOMNI_CHAT_DB=
# max size per uploaded file, in MB. Default (2048) covers raw instrument
# files like .mzML mass spec runs, which are often several hundred MB+.
MAX_UPLOAD_MB=2048
PORT=8000
