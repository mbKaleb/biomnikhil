# ---- model ----
# biomnikhil runs Claude on Amazon Bedrock, signed with your Cognito sign-in
# (no API key). Optional: the model to start on; leave empty for the default
# in app/providers.py (anthropic.claude-haiku-4-5).
BIOMNI_MODEL=

# ---- Cognito (public ids, not secrets) ----
AWS_REGION=us-east-1
COGNITO_DOMAIN=https://us-east-1quu8gd7jm.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=5oibl9n3pa4u3hrguupqe9nk60
COGNITO_USER_POOL_ID=us-east-1_QUu8gD7Jm
COGNITO_IDENTITY_POOL_ID=us-east-1:3e9729cb-6342-4f29-b4ab-0393236e8d1a
# must be an allowed callback URL on the app client; defaults to
# http://localhost:$PORT/callback
COGNITO_REDIRECT_URI=

# ---- paths / server ----
# defaults live inside the repo: data/ (biomni's data lake) and
# data/user/ (uploads, chat history) — the whole tree is gitignored.
BIOMNI_DATA_PATH=
BIOMNI_UPLOAD_PATH=
BIOMNI_CHAT_DB=
# max size per uploaded file, in MB. Default (2048) covers raw instrument
# files like .mzML mass spec runs, which are often several hundred MB+.
MAX_UPLOAD_MB=2048
PORT=8000
